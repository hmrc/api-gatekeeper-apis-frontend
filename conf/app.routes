# microservice specific routes

->         /hmrc-frontend                   hmrcfrontend.Routes

GET        /                                uk.gov.hmrc.apigatekeeperapisfrontend.controllers.ApiListController.page
GET        /csv                             uk.gov.hmrc.apigatekeeperapisfrontend.controllers.ApiListController.csv
GET        /api-details/:serviceName        uk.gov.hmrc.apigatekeeperapisfrontend.controllers.ApiDetailsController.page(serviceName: String)
GET        /api-details/:serviceName/events uk.gov.hmrc.apigatekeeperapisfrontend.controllers.ApiDetailsController.events(serviceName: String)

GET        /assets/*file                    controllers.Assets.versioned(path = "/public", file: Asset)
